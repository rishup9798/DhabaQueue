generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                  String   @id @default(uuid())
  name                String
  whatsappNumber      String   @unique
  avgTurnoverMinutes  Int      @default(25)
  createdAt           DateTime @default(now())

  aiDailyLimit        Int      @default(500)
  aiCallsToday        Int      @default(0)
  aiCallsResetAt      DateTime @default(now())

  tables              Table[]
  queueEntries        QueueEntry[]
  staff               StaffUser[]
  conversations       ConversationState[]
}

model Table {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  number       Int
  capacity     Int
  status       TableStatus  @default(FREE)
  updatedAt    DateTime     @updatedAt

  queueEntries QueueEntry[]

  @@unique([restaurantId, number])
}

enum TableStatus {
  FREE
  OCCUPIED
}

model Customer {
  phoneNumber    String   @id
  name           String?
  visitCount     Int      @default(0)
  lastVisitAt    DateTime?
  notes          String?
  isWalkIn       Boolean  @default(false)

  aiDailyLimit   Int      @default(10)
  aiCallsToday   Int      @default(0)
  aiCallsResetAt DateTime @default(now())

  queueEntries QueueEntry[]
}

model QueueEntry {
  id                   String        @id @default(uuid())
  restaurantId         String
  restaurant           Restaurant    @relation(fields: [restaurantId], references: [id])
  customerPhoneNumber  String
  customer             Customer      @relation(fields: [customerPhoneNumber], references: [phoneNumber])
  partySize            Int
  status               QueueStatus   @default(WAITING)
  estimatedWaitMinutes Int
  joinedAt             DateTime      @default(now())
  notifiedAt           DateTime?
  seatedAt             DateTime?
  isAtRisk             Boolean       @default(false)
  source               EntrySource   @default(WHATSAPP)

  tableId              String?
  table                Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)

  foodOrder            FoodOrder?

  @@index([tableId])
}

enum EntrySource {
  WHATSAPP
  STAFF_MANUAL
}

enum QueueStatus {
  WAITING
  NOTIFIED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ConversationState {
  phoneNumber   String           @id
  restaurantId  String
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  step          ConversationStep @default(AWAITING_NAME)
  updatedAt     DateTime         @updatedAt
}

enum ConversationStep {
  AWAITING_NAME
  AWAITING_PARTY_SIZE
  IN_QUEUE
}

model StaffUser {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
}

model FoodOrder {
  id              String      @id @default(uuid())
  queueEntryId    String      @unique
  queueEntry      QueueEntry  @relation(fields: [queueEntryId], references: [id])
  itemsSummary    String
  status          FoodStatus  @default(ORDERED)
  readyNotifiedAt DateTime?
  servedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum FoodStatus {
  ORDERED
  PREPARING
  READY
  SERVED
}